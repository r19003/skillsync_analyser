PORT=5000
NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/skillsync

# ── Security ─────────────────────────────────────────────────────────────────
JWT_SECRET=your_very_long_secret_here
JWT_EXPIRE=7d

# ── Client Config ────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# ── Grok AI (xAI) ─────────────────────────────────────────────────────────────
# Used for: deep resume critique, JD comparison, recruiter-style analysis,
#           weakness identification, ATS observations, strategic recommendations
# Get key at: https://console.x.ai/
GROK_API_KEY=your_grok_api_key_here
GROK_API_URL=https://api.x.ai/v1
GROK_MODEL=grok-3-mini

# ── Google Gemini ──────────────────────────────────────────────────────────────
# Used for: structured study plan generation, learning roadmap, weekly task
#           breakdown, project recommendations, interview prep, milestones
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
