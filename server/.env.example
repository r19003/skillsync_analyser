# ============================================================
# SkillSync Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/skillsync

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# ── Client ────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# ── Grok AI (xAI) ─────────────────────────────────────────────────────────────
# Purpose: Deep resume critique, recruiter-style JD comparison, ATS analysis,
#          weakness identification, strategic recommendations, action plan.
# Get key : https://console.x.ai/
GROK_API_KEY=
GROK_API_URL=https://api.x.ai/v1
GROK_MODEL=grok-3-mini

# ── Google Gemini ──────────────────────────────────────────────────────────────
# Purpose: Structured study plan, week-by-week roadmap, project recommendations,
#          interview prep topics, milestones, task breakdown.
# Get key : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
